# Cursor API key (required)
CURSOR_API_KEY=

# Optional model id (default composer-2.5)
CURSOR_AGENT_MODEL=composer-2.5

# Postgres (same style as API CONN_STRING key=value OR postgres URL)
CONN_STRING=host=127.0.0.1 port=5432 user=postgres password=CHANGE_ME dbname=ref-test sslmode=disable

# Repo root for Cursor local cwd (defaults to parent of /agent)
# AGENT_CWD=D:\ref-main\ref-ai\ref-ai-test\app

# Poll interval ms
AGENT_POLL_MS=4000
